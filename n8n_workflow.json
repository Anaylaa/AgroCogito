    {
      "parameters": {
        "jsCode": "// Validação de Cotações da B3 com atraso de no máximo 60 minutos\nconst referenceTime = new Date();\nconst b3Contracts = items[0].json.b3.contracts;\n\nconst validContracts = b3Contracts.filter(c => {\n  const quoteTime = new Date(c.quoteTimestamp);\n  const diffMinutes = (referenceTime - quoteTime) / (1000 * 60);\n  return diffMinutes >= 0 && diffMinutes <= 60;\n});\n\nitems[0].json.b3.contracts = validContracts;\nitems[0].json.b3.validatedAt = referenceTime.toISOString();\nreturn items;"
      },
      "id": "d1a89b2c-2931-419b-a010-00d810fdbe92",
      "name": "Validar Idade Cotações (<60 min)",
